# CareSphere MVP - Production Environment Variables
# Copy this file to .env before running docker-compose up -d

# --- Frontend ---
# Leave blank to automatically use the current domain, or specify explicitly:
# VITE_API_URL=https://api.yourdomain.com/api

# --- Backend ---
# Flask Settings
FLASK_ENV=production
SECRET_KEY=generate-a-secure-random-string-here
JWT_SECRET_KEY=generate-another-secure-random-string-here

# Postgres Database Settings
POSTGRES_USER=ehs_admin
POSTGRES_PASSWORD=secure_postgres_password_here
POSTGRES_DB=ehs_production

# Twilio Configuration (For SMS notifications)
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_token
# TWILIO_FROM_NUMBER=your_twilio_number
